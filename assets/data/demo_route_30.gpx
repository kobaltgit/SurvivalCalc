  </wpt>
  <wpt lat="43.9550" lon="39.8250">
    <ele>1788.0</ele>
    <name>Перевал Белореченский</name>
    <sym>Mountain Peak</sym>
    <type>pass</type>
  </wpt>
  <wpt lat="43.9420" lon="39.8050">
    <ele>1836.0</ele>
    <name>Перевал Черкесский (Пастуший)</name>
    <sym>Mountain Peak</sym>
    <type>pass</type>
  </wpt>
  <wpt lat="43.8750" lon="39.7210">
